{
  "name": "clawd",
  "version": "1.0.0",
  "description": "Clawd — a pixel Claude desktop pet that actually does your tasks (Claude Agent SDK inside)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:agent": "node test/agent-smoke.mjs",
    "package": "electron-packager . Clawd --platform=darwin --arch=arm64 --out=dist --overwrite --no-asar"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.221"
  },
  "devDependencies": {
    "electron": "^43.5.0",
    "@electron/packager": "^20.0.0"
  }
}
